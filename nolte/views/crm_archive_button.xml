        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        icon="fa-archive"
                        name="toggle_active"
                        string="Archiv">
                </button>
            </div>
        </field>
    </record>
</odoo>
