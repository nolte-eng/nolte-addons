<odoo>
    <data>
        <record model="ir.ui.view" id="hinzufuegen_Verantwortlicher">
            <field name="name">Mitarbeiter</field>
            <field name="model">calendar.event</field>
            <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='options']" position="inside">
                    <group string="Mitarbeiter">
                        <label for="user_id" string="Mitarbeiter"/>
                        <field name="user_id"
                               nolabel="1"
                               can_create="true"
                               can_write="true"
                               modifiers="{'readonly': [['state', 'in', ['done']]]}"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
