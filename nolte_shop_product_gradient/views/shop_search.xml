<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template
        id="nolte_shop_visible_product_search"
        inherit_id="website_sale.filmstrip_categories"
        name="Nolte sichtbare Produktsuche"
    >
        <xpath
            expr="//div[@id='o_wsale_categories_filmstrip']"
            position="after"
        >
            <div class="nolte_shop_product_search">
                <form
                    method="get"
                    class="o_searchbar_form s_searchbar_input nolte_shop_search_form"
                    data-snippet="s_searchbar_input"
                >
                    <label
                        for="nolte_shop_search_input"
                        class="visually-hidden"
                    >
                        Produkte durchsuchen
                    </label>

                    <div role="search" class="input-group">
                        <input
                            id="nolte_shop_search_input"
                            type="search"
                            name="search"
                            class="search-query form-control oe_search_box"
                            placeholder="Hersteller, Artikelnummer oder Produkt suchen …"
                            t-att-value="request.params.get('search', '')"
                            data-search-type="products"
                            data-limit="7"
                            data-display-image="true"
                            data-display-description="true"
                            data-display-extra-link="true"
                            data-display-detail="true"
                            data-order-by="name asc"
                            autocomplete="off"
                        />

                        <button
                            type="submit"
                            class="btn oe_search_button"
                            aria-label="Produkte suchen"
                            title="Produkte suchen"
                        >
                            <i class="oi oi-search"/>
                            <span class="d-none d-sm-inline ms-2">
                                Suchen
                            </span>
                        </button>
                    </div>
                    <input name="order" type="hidden" class="o_search_order_by oe_unremovable" value="name asc"/>
                </form>
                <button
                    type="button"
                    class="btn nolte_shop_sort_button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#o_wsale_offcanvas"
                    aria-controls="o_wsale_offcanvas"
                >
                    <i class="oi oi-settings-adjust me-2"/>
                    Sortieren
                </button>
            </div>
        </xpath>
    </template>
</odoo>
