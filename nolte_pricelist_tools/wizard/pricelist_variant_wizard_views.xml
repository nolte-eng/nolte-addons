<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nolte_pricelist_variant_wizard_form" model="ir.ui.view">
        <field name="name">nolte.pricelist.variant.wizard.form</field>
        <field name="model">nolte.pricelist.variant.wizard</field>
        <field name="arch" type="xml">
            <form string="Produktvarianten hinzufügen">
                <group>
                    <field name="pricelist_id"/>
                    <field name="product_tmpl_id" options="{'no_create': True}"/>
                    <field name="variant_count" readonly="1"/>
                </group>
                <group string="Preisberechnung">
                    <field name="price_source"/>
                    <field name="percentage"/>
                    <field name="rounding"/>
                </group>
                <group string="Optionen">
                    <field name="overwrite_existing"/>
                    <field name="include_archived"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Varianten hinzufügen" class="btn-primary"/>
                    <button string="Abbrechen" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
