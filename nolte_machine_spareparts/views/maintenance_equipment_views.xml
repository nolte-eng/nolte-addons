<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_maintenance_equipment_form_inherit_nolte_machine_spareparts" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.nolte.machine.spareparts</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="bom_id" readonly="1" invisible="1"/>
            </xpath>

            <xpath expr="//div[contains(@class,'oe_button_box')]" position="inside">
                <button name="action_view_spare_parts"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-wrench"
                        invisible="not product_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Ersatzteile</span>
                    </div>
                </button>
                <button name="action_print_spare_parts_catalog"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-pdf-o"
                        invisible="not product_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">PDF Katalog</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
