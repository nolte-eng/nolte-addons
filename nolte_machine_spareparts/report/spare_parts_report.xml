<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_spare_parts_catalog" model="ir.actions.report">
        <field name="name">Ersatzteilkatalog</field>
        <field name="model">maintenance.equipment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nolte_machine_spareparts.report_spare_parts_catalog</field>
        <field name="report_file">nolte_machine_spareparts.report_spare_parts_catalog</field>
        <field name="print_report_name">'Ersatzteilkatalog - %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_spare_parts_catalog">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Ersatzteilkatalog</h2>

                        <table class="table table-sm o_main_table">
                            <tbody>
                                <tr>
                                    <th style="width: 25%;">Maschine / Equipment</th>
                                    <td><span t-esc="o.name"/></td>
                                </tr>
                                <tr t-if="o.partner_id">
                                    <th>Kunde</th>
                                    <td><span t-esc="o.partner_id.display_name"/></td>
                                </tr>
                                <tr t-if="o.serial_no">
                                    <th>Seriennummer</th>
                                    <td><span t-esc="o.serial_no"/></td>
                                </tr>
                                <tr t-if="o.product_id">
                                    <th>Maschinenmodell</th>
                                    <td>
                                        <span t-esc="o.product_id.display_name"/>
                                        <t t-if="o.product_id.default_code">
                                            (<span t-esc="o.product_id.default_code"/>)
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <t t-set="bom" t-value="o.bom_id"/>
                        <t t-if="not bom">
                            <p><strong>Hinweis:</strong> Keine Stückliste (BOM) gefunden.</p>
                        </t>
                        <t t-if="bom">
                            <h3 style="margin-top: 16px;">Ersatzteile (aus Stückliste)</h3>

                            <table class="table table-sm table-hover">
                                <thead>
                                    <tr>
                                        <th style="width: 6%;">Pos</th>
                                        <th style="width: 14%;">Art.-Nr.</th>
                                        <th>Bezeichnung</th>
                                        <th style="width: 10%; text-align: right;">Menge</th>
                                        <th style="width: 10%;">ME</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="pos" t-value="0"/>
                                    <t t-foreach="bom.bom_line_ids" t-as="l">
                                        <t t-set="pos" t-value="pos + 1"/>
                                        <tr>
                                            <td><span t-esc="pos"/></td>
                                            <td><span t-esc="l.product_id.default_code or ''"/></td>
                                            <td><span t-esc="l.product_id.display_name"/></td>
                                            <td style="text-align: right;"><span t-esc="l.product_qty"/></td>
                                            <td><span t-esc="l.product_uom_id.name"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <p style="margin-top: 10px; font-size: 10px; color: #666;">
                                Hinweis: Diese Ersatzteilliste basiert auf der hinterlegten Stückliste (BOM) des Maschinenmodells.
                                Änderungen am Maschinenstand können abweichen.
                            </p>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
