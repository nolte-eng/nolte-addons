<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="paperformat_next" model="report.paperformat">
        <field name="name">Nolte Next – A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">34</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">18</field>
        <field name="margin_right">14</field>
        <field name="header_spacing">28</field>
        <field name="dpi">90</field>
    </record>
    <template id="report_saleorder">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="nolte_reports_next.sale_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>
    <record id="action_report_sale_next" model="ir.actions.report">
        <field name="name">Angebot / Auftrag – Nolte Next (Test)</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nolte_reports_next.report_saleorder</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_next"/>
        <field name="print_report_name">'Nolte-%s' % object.name.replace('/', '-')</field>
    </record>
    <!-- Only route when explicitly enabled; the old document remains untouched. -->
    <template id="route_normal_sale" inherit_id="sale.report_saleorder_raw" priority="90">
        <xpath expr="//t[@t-call='sale.report_saleorder_document']" position="replace">
            <t t-if="doc.company_id.nolte_next_sale_enabled">
                <t t-call="nolte_reports_next.sale_document" t-lang="doc.partner_id.lang"/>
            </t>
            <t t-else="">
                <t t-call="sale.report_saleorder_document" t-lang="doc.partner_id.lang"/>
            </t>
        </xpath>
    </template>
    <template id="route_proforma" inherit_id="sale.report_saleorder_pro_forma" priority="90">
        <xpath expr="//t[@t-call='sale.report_saleorder_document']" position="replace">
            <t t-if="doc.company_id.nolte_next_sale_enabled">
                <t t-call="nolte_reports_next.sale_document" t-lang="doc.partner_id.lang"/>
            </t>
            <t t-else="">
                <t t-call="sale.report_saleorder_document" t-lang="doc.partner_id.lang"/>
            </t>
        </xpath>
    </template>
</odoo>
