<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!--Derived from Odoo Community 19.0-20260817 (Odoo S.A., LGPL-3). See UPSTREAM.md.-->
    <template id="tax_totals">
        <t t-set="same_tax_base" t-value="tax_totals['same_tax_base']" />
        <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
            <tr t-if="subtotal['tax_groups']" class="o_subtotal">
                <td>
                    <span t-out="subtotal['name']">Untaxed Amount</span>
                </td>
                <td class="text-end">
                    <span t-att-class="oe_subtotal_footer_separator" t-out="subtotal['base_amount_currency']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}">27.00</span>
                </td>
            </tr>
            <t t-foreach="subtotal['tax_groups']" t-as="tax_group">
                <tr class="o_taxes">
                    <t t-if="same_tax_base or tax_group['display_base_amount_currency'] is False">
                        <td style="max-width: 200px;">
                            <span t-out="tax_group['group_name']">Tax 15%</span>
                        </td>
                        <td class="text-end o_price_total">
                            <span class="text-nowrap" t-out="tax_group['tax_amount_currency']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}">1.05</span>
                        </td>
                    </t>
                    <t t-else="">
                        <td>
                            <span t-out="tax_group['group_name']">Tax 15%</span>
                            <span> auf </span>
                            <span class="text-nowrap" t-out="tax_group['display_base_amount_currency']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}">27.00</span>
                        </td>
                        <td class="text-end o_price_total">
                            <span class="text-nowrap" t-out="tax_group['tax_amount_currency']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}">4.05</span>
                        </td>
                    </t>
                </tr>
            </t>
        </t>
        <tr t-if="'cash_rounding_base_amount_currency' in tax_totals">
            <td>Rundung</td>
            <td class="text-end">
                <span t-out="tax_totals['cash_rounding_base_amount_currency']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}">0</span>
            </td>
        </tr>
        <tr class="o_total">
            <td>
                <strong>Gesamtbetrag</strong>
            </td>
            <td class="text-end">
                <strong t-out="tax_totals['total_amount_currency']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}">31.05</strong>
            </td>
        </tr>
    </template>
    <template id="sale_document">
        <t t-call="nolte_reports_next.external_layout">
            <t t-set="information_block" t-value="False" />
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
            <t t-set="forced_vat" t-value="doc.fiscal_position_id.foreign_vat" />
            <t t-set="address">
                <div t-field="doc.partner_id" class="mb-0" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}" />
                <p t-if="doc.partner_id.vat" class="mb-0">
                    <t t-if="doc.company_id.account_fiscal_country_id.vat_label" t-out="doc.company_id.account_fiscal_country_id.vat_label" />
                    <t t-else="">USt-IdNr.</t>: <span t-field="doc.partner_id.vat" />
                </p>
            </t>
            <t t-if="doc.partner_shipping_id == doc.partner_invoice_id                              and doc.partner_invoice_id != doc.partner_id                              or doc.partner_shipping_id != doc.partner_invoice_id">
                <t t-set="information_block">
                    <t t-if="doc.partner_shipping_id == doc.partner_invoice_id">
                        <strong>Rechnungs- und Lieferadresse</strong>
                        <div t-field="doc.partner_invoice_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}" />
                    </t>
                    <div t-else="" class="row">
                        <div t-if="doc.partner_id != doc.partner_invoice_id" t-att-class="doc.partner_id != doc.partner_shipping_id and 'col-6 pe-1'">
                            <strong>Rechnungsadresse</strong>
                            <div t-field="doc.partner_invoice_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}" />
                        </div>
                        <div t-if="doc.partner_id != doc.partner_shipping_id" t-att-class="doc.partner_id != doc.partner_invoice_id and 'col-6 ps-1'">
                            <strong>Lieferadresse</strong>
                            <div t-field="doc.partner_shipping_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}" />
                        </div>
                    </div>
                </t>
            </t>
            <div class="page">
                <div class="oe_structure" />
                <t t-set="is_proforma" t-value="env.context.get('proforma', False) or is_pro_forma" />
                <t t-call="nolte_reports_next.address_and_title" />
                <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()" />
                <t t-set="display_discount" t-value="any(l.discount &gt; 0 for l in lines_to_report)" />
                <t t-set="hide_taxes_details" t-value="False" />
                <t t-set="display_taxes" t-value="not hide_taxes_details and any(l._has_taxes() for l in lines_to_report)" />
                <div class="oe_structure" />
                <table class="o_has_total_table table o_main_table table-borderless">
                    <thead style="display: table-header-group">
                        <tr>
                            <th name="th_description" class="text-start">Beschreibung</th>
                            <th name="th_quantity" class="text-end text-nowrap">Menge</th>
                            <th name="th_priceunit" class="text-end text-nowrap">Einzelpreis</th>
                            <th name="th_discount" t-if="display_discount" class="text-end">
                                <span>Rabatt %</span>
                            </th>
                            <th name="th_taxes" t-if="display_taxes" class="text-end">
                                <span>Steuern</span>
                            </th>
                            <th name="th_subtotal" class="text-end">
                                <span>Betrag</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody">
                        <t t-set="current_section" t-value="None" />
                        <t t-set="current_subsection" t-value="None" />
                        <t t-set="price_field" t-value="'price_total' if (hide_taxes_details or doc.company_price_include == 'tax_included') else 'price_subtotal'" />
                        <t t-foreach="lines_to_report" t-as="line">
                            <t t-set="is_note" t-value="line.display_type == 'line_note'" />
                            <t t-set="is_section" t-value="line.display_type == 'line_section'" />
                            <t t-set="is_subsection" t-value="line.display_type == 'line_subsection'" />
                            <t t-set="is_combo" t-value="line.product_type == 'combo'" />
                            <t t-if="is_section">
                                <t t-set="current_section" t-value="line" />
                                <t t-set="current_subsection" t-value="None" />
                                <t t-set="line_padding" t-value="0" />
                                <t t-set="collapse_prices" t-value="line.collapse_prices" />
                            </t>
                            <t t-elif="is_subsection">
                                <t t-set="current_subsection" t-value="line" />
                                <t t-set="line_padding" t-value="2" />
                                <t t-set="collapse_prices" t-value="collapse_prices or line.collapse_prices" />
                            </t>
                            <t t-else="">
                                <t t-set="line_padding" t-value="3 if current_subsection else (2 if current_section else 0)" />
                            </t>
                            <t t-if="line.combo_item_id">
                                <t t-set="line_padding" t-value="line_padding + 1" />
                            </t>
                            <t t-set="padding_class" t-value="line_padding and ('px-' + str(line_padding)) or ''" />
                            <t t-set="show_section_total" t-value="is_section or not line.parent_id.collapse_prices" />
                            <t t-if="not line.collapse_composition">
                                <tr t-if="is_section or is_subsection" name="tr_section" t-att-class="'fw-bolder o_line_section' if is_section else 'fw-bold o_line_subsection'">
                                    <t t-set="show_section_total" t-value="(                                         (                                             is_section                                             or not line.parent_id.collapse_prices                                         )                                         and not line.is_downpayment                                     )" />
                                    <t t-set="section_name_colspan" t-value="3 + (1 if display_discount else 0) + (1 if display_taxes else 0)" />
                                    <t t-if="not show_section_total">
                                        <t t-set="section_name_colspan" t-value="99" />
                                    </t>
                                    <td name="td_section_name" t-att-colspan="section_name_colspan" t-att-class="padding_class">
                                        <span t-field="line.name">A section title</span>
                                    </td>
                                    <td t-if="show_section_total" name="td_section_price" class="text-end o_price_total">
                                        <span name="price_subtotal_section" t-out="line._get_section_totals(price_field)" class="text-nowrap" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}">
                                        27.00
                                    </span>
                                    </td>
                                </tr>
                                <t t-elif="is_note">
                                    <tr t-foreach="(line.name or '').split('\n')" t-as="note_line" class="nn-detail-row o_line_note">
                                        <td colspan="99">
                                            <span t-if="note_line" t-out="note_line" />
                                            <div t-else="" class="nn-empty-line" />
                                        </td>
                                    </tr>
                                </t>
                                <tr t-elif="is_combo" name="tr_combo" class="fw-bold o_line_subsection">
                                    <td name="td_combo_name" t-att-colspan="3 + (1 if display_discount else 0) + (1 if display_taxes else 0)" t-att-class="padding_class">
                                        <span t-field="line.name">Combo Product</span>
                                    x <span t-field="line.product_uom_qty" t-options="{'widget': 'integer'}" />
                                    </td>
                                    <td name="td_combo_price" class="text-end o_price_total">
                                        <span t-if="not collapse_prices" name="price_subtotal_combo" t-out="line._get_combo_totals(price_field)" class="text-nowrap" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}">
                                        27.00
                                    </span>
                                    </td>
                                </tr>
                                <tr t-else="" name="tr_product" t-att-style="'page-break-after: avoid;' if len((line.name or '').split('\n', 1)) &gt; 1 else ''">
                                    <td name="td_product_name" t-att-class="padding_class">
                                        <t>
                                            <t t-set="description_parts" t-value="(line.name or '').split('\n', 1)" />
                                            <div class="nn-product-title" t-out="description_parts[0]" />
                                        </t>
                                    </td>
                                    <td name="td_product_quantity" class="o_td_quantity text-end">
                                        <span t-field="line.product_uom_qty" class="text-nowrap">3</span>
                                        <span t-field="line.product_uom_id">units</span>
                                        <span t-if="line.product_uom_id != line.product_id.uom_id" class="text-muted small">
                                            <t t-set="quantity_in_product_uom" t-value="line.product_uom_id._compute_quantity(line.product_uom_qty, line.product_id.uom_id)" />
                                            <br />
                                            <span t-esc="quantity_in_product_uom" t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}" />
                                            <span t-field="line.product_id.uom_id" />
                                        </span>
                                    </td>
                                    <td name="td_product_priceunit" class="text-end text-nowrap">
                                        <span t-if="not collapse_prices and line.discount &lt; 0" t-out="(1 - line.discount / 100.0) * line.price_unit" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;decimal_precision&quot;: &quot;Product Price&quot;}" />
                                        <span t-elif="not collapse_prices" t-field="line.price_unit">
                                        25.00
                                    </span>
                                    </td>
                                    <td t-if="display_discount" name="td_product_discount" class="text-end">
                                        <t t-if="not collapse_prices">
                                            <span t-if="line.discount &gt; 0" t-field="line.discount">-</span>
                                        </t>
                                    </td>
                                    <t t-set="taxes" t-value="', '.join(tax.tax_label for tax in line.tax_ids if tax.tax_label)" />
                                    <td t-if="display_taxes" name="td_product_taxes" t-attf-class="text-end {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                        <span t-out="taxes">Tax 15%</span>
                                    </td>
                                    <td name="td_product_subtotal" class="text-end o_price_total">
                                        <t t-if="not line.is_downpayment and not collapse_prices">
                                            <span t-if="price_field == 'price_subtotal'" t-field="line.price_subtotal">
                                            27.00
                                        </span>
                                            <span t-else="" t-field="line.price_total">
                                            27.00
                                        </span>
                                        </t>
                                    </td>
                                </tr>
                                <t t-if="not is_section and not is_subsection and not is_note and not is_combo">
                                    <tr t-foreach="(line.name or '').split('\n')[1:]" t-as="detail" class="nn-detail-row">
                                        <td colspan="99">
                                            <span t-if="detail" t-out="detail" />
                                            <div t-else="" class="nn-empty-line" />
                                        </td>
                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <tr t-foreach="line._get_grouped_section_summary(display_taxes)" t-as="section_line" name="tr_section_group" class="o_line_section">
                                    <td name="td_section_group_name" t-att-class="padding_class">
                                        <span t-field="line.name">
                                        Section Summary
                                    </span>
                                    </td>
                                    <td name="td_section_group_quantity" class="text-end text-nowrap">
                                        <span>1.00 Units</span>
                                    </td>
                                    <td name="td_section_group_priceunit" class="text-end text-nowrap">
                                        <span t-if="show_section_total" name="price_subtotal_section_grouped" t-out="section_line['price_subtotal']" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}">
                                        25.00
                                    </span>
                                    </td>
                                    <td t-if="display_discount" name="td_section_group_discount">
                                        <t t-set="aggregated_discount" t-value="section_line.get('discount', 0)" />
                                        <span t-if="aggregated_discount" t-out="aggregated_discount">-</span>
                                    </td>
                                    <td t-if="display_taxes" name="td_section_group_taxes" t-attf-class="text-end {{ 'text-nowrap' if len(section_line['tax_labels']) &lt; 10 else '' }}">
                                        <span t-out="', '.join(section_line['tax_labels'])">
                                        Tax 15%
                                    </span>
                                    </td>
                                    <td name="td_section_group_total" class="text-end o_price_total">
                                        <span t-if="show_section_total" t-out="section_line[price_field]" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}">
                                        30.00
                                    </span>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>
                <div class="clearfix" name="so_total_summary">
                    <div id="total" class="row mt-n3" name="total">
                        <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                            <table class="o_total_table table table-borderless">
                                <t t-call="nolte_reports_next.tax_totals">
                                    <t t-set="tax_totals" t-value="doc.tax_totals" />
                                    <t t-set="currency" t-value="doc.currency_id" />
                                </t>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="oe_structure" />
                <div t-if="not doc.signature or not doc.env.context.get('sale_include_signature')" class="oe_structure" />
                <div t-else="" class="mt-4 ml64 mr4" name="signature">
                    <div class="offset-8">
                        <strong>Unterschrift</strong>
                    </div>
                    <div class="offset-8">
                        <img t-att-src="image_data_uri(doc.signature)" style="max-height: 4cm; max-width: 8cm;" />
                    </div>
                    <div class="offset-8 text-center">
                        <span t-field="doc.signed_by">Oscar Morgan</span>
                    </div>
                </div>
                <div class="nn-terms">
                    <span t-field="doc.note" t-attf-style="#{'text-align:justify;text-justify:inter-word;' if doc.company_id.terms_type != 'html' else ''}" name="order_note" t-if="doc._nolte_next_show_note()" />
                    <div t-if="not is_html_empty(doc.payment_term_id.note)">
                        <strong>Zahlungsbedingungen</strong>
                        <br />
                        <div t-out="doc._nolte_next_payment_note()" />
                    </div>
                    <div class="oe_structure" />
                    <p t-if="doc.fiscal_position_id and not is_html_empty(doc.fiscal_position_id.sudo().note)" id="fiscal_position_remark">
                        <strong>Hinweis zur Steuerposition:</strong>
                        <span t-field="doc.fiscal_position_id.sudo().note">No further requirements for this payment</span>
                    </p>
                </div>
                <div class="oe_structure" />
            </div>
        </t>
    </template>
</odoo>
