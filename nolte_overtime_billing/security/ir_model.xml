<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Provide stable external IDs for our models so ir.model.access.csv can
        resolve model references during installation/upgrade (some setups do not
        have the auto-generated base.model_* external IDs at this stage).
    -->
    <record id="model_nolte_overtime_settings" model="ir.model">
        <field name="name">Nolte Überstunden – Einstellungen</field>
        <field name="model">nolte.overtime.settings</field>
    </record>

    <record id="model_nolte_overtime_import_wizard" model="ir.model">
        <field name="name">Nolte Überstunden – CSV Import</field>
        <field name="model">nolte.overtime.import.wizard</field>
    </record>
</odoo>
