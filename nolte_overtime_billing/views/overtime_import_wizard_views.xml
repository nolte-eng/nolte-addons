<odoo>
  <record id="view_nolte_overtime_import_wizard_form" model="ir.ui.view">
    <field name="name">nolte.overtime.import.wizard.form</field>
    <field name="model">nolte.overtime.import.wizard</field>
    <field name="arch" type="xml">
      <form string="Stundenbericht CSV importieren">
        <group>
          <field name="csv_file" filename="csv_filename"/>
          <field name="csv_filename" invisible="1"/>
        </group>
        <footer>
          <button name="action_import_create_sale_order" type="object" string="Verkaufsauftrag erstellen" class="btn-primary"/>
          <button string="Abbrechen" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_nolte_overtime_import_wizard" model="ir.actions.act_window">
    <field name="name">Stundenbericht CSV Import</field>
    <field name="res_model">nolte.overtime.import.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
