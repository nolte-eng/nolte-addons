<odoo>
  <record id="view_nolte_overtime_import_wizard_form" model="ir.ui.view">
    <field name="name">nolte.overtime.import.wizard.form</field>
    <field name="model">nolte.overtime.import.wizard</field>
    <field name="arch" type="xml">
      <form string="Import Timesheet CSV">
        <group>
          <field name="csv_file" filename="csv_filename"/>
          <field name="csv_filename" invisible="1"/>
        </group>
        <group string="Import Target">
          <field name="import_target" widget="radio"/>
          <field name="order_id" invisible="import_target != 'existing'" options="{'no_create_edit': False}"/>
        </group>
        <group string="Customer">
          <field name="detected_partner_name" readonly="1"/>
          <field name="partner_id" options="{'no_create_edit': False}"/>
          <field name="create_partner_if_missing" invisible="import_target == 'existing'"/>
        </group>
        <group string="Create New Contact" invisible="not create_partner_if_missing">
          <field name="new_partner_name"/>
          <field name="new_partner_street"/>
          <field name="new_partner_zip"/>
          <field name="new_partner_city"/>
          <field name="new_partner_country_id"/>
        </group>
        <group string="Expense Report">
          <field name="import_to_expense_report"/>
          <field name="detected_employee_name" readonly="1" invisible="not import_to_expense_report"/>
          <field name="expense_employee_id" invisible="not import_to_expense_report"/>
        </group>
        <footer>
          <button name="action_import_create_sale_order" type="object" string="Create Sales Order" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_nolte_overtime_import_wizard" model="ir.actions.act_window">
    <field name="name">Timesheet CSV Import</field>
    <field name="res_model">nolte.overtime.import.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
