<odoo>
  <record id="view_res_config_settings_nolte_overtime" model="ir.ui.view">
    <field name="name">res.config.settings.nolte.overtime</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="priority" eval="200"/>
    <field name="arch" type="xml">
      <xpath expr="//div[hasclass('settings')]" position="inside">
        <div class="app_settings_block" data-string="Nolte Überstunden – CSV Import" string="Nolte Überstunden – CSV Import">
          <h2>Nolte Überstunden – CSV Import</h2>
          <div class="text-muted">
            Ordne einmalig die Produkte zu. Der Import erzeugt daraus einen Verkaufsauftrag inkl. Notiz-Zeile.
          </div>

          <div class="row mt16">
            <!-- NORMAL -->
            <div class="col-12">
              <h3 class="mt16">Normal</h3>
              <div class="text-muted">Reguläre Arbeits- und Fahrzeit</div>
            </div>

            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane"/>
              <div class="o_setting_right_pane">
                <label for="nolte_product_work_id"/>
                <div class="text-muted">Produkt für Arbeitszeit (normal)</div>
                <field name="nolte_product_work_id" options="{'no_create': False}"/>
              </div>
            </div>

            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane"/>
              <div class="o_setting_right_pane">
                <label for="nolte_product_travel_id"/>
                <div class="text-muted">Produkt für Fahrzeit (normal)</div>
                <field name="nolte_product_travel_id" options="{'no_create': False}"/>
              </div>
            </div>

            <!-- ÜBERSTUNDEN ARBEITSZEIT -->
            <div class="col-12">
              <hr class="mt16 mb16"/>
              <h3>Überstunden Arbeitszeit</h3>
              <div class="text-muted">OT30: ab 8–10h • OT50: über 10h</div>
            </div>

            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane"/>
              <div class="o_setting_right_pane">
                <label for="nolte_product_work_ot30_id"/>
                <div class="text-muted">Produkt für Arbeitszeit Überstunden 30%</div>
                <field name="nolte_product_work_ot30_id" options="{'no_create': False}"/>
              </div>
            </div>

            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane"/>
              <div class="o_setting_right_pane">
                <label for="nolte_product_work_ot50_id"/>
                <div class="text-muted">Produkt für Arbeitszeit Überstunden 50%</div>
                <field name="nolte_product_work_ot50_id" options="{'no_create': False}"/>
              </div>
            </div>

            <!-- ÜBERSTUNDEN FAHRZEIT -->
            <div class="col-12">
              <hr class="mt16 mb16"/>
              <h3>Überstunden Fahrzeit</h3>
              <div class="text-muted">OT30: ab 8–10h • OT50: über 10h</div>
            </div>

            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane"/>
              <div class="o_setting_right_pane">
                <label for="nolte_product_travel_ot30_id"/>
                <div class="text-muted">Produkt für Fahrzeit Überstunden 30%</div>
                <field name="nolte_product_travel_ot30_id" options="{'no_create': False}"/>
              </div>
            </div>

            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane"/>
              <div class="o_setting_right_pane">
                <label for="nolte_product_travel_ot50_id"/>
                <div class="text-muted">Produkt für Fahrzeit Überstunden 50%</div>
                <field name="nolte_product_travel_ot50_id" options="{'no_create': False}"/>
              </div>
            </div>

            <!-- ZUSÄTZE -->
            <div class="col-12">
              <hr class="mt16 mb16"/>
              <h3>Zusätze</h3>
              <div class="text-muted">Optional: werden nur importiert, wenn Daten/Produkte vorhanden sind</div>
            </div>

            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane"/>
              <div class="o_setting_right_pane">
                <label for="nolte_product_km_id"/>
                <div class="text-muted">Produkt für Kilometer</div>
                <field name="nolte_product_km_id" options="{'no_create': False}"/>
              </div>
            </div>

            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane"/>
              <div class="o_setting_right_pane">
                <label for="nolte_product_overnight_id"/>
                <div class="text-muted">Produkt für Übernachtungspauschale</div>
                <field name="nolte_product_overnight_id" options="{'no_create': False}"/>
              </div>
            </div>

          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
