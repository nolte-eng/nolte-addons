<odoo>
  <!-- Standalone settings wizard (persists via ir.config_parameter) -->

  <record id="view_nolte_overtime_settings_form" model="ir.ui.view">
    <field name="name">nolte.overtime.settings.form</field>
    <field name="model">nolte.overtime.settings</field>
    <field name="arch" type="xml">
      <form string="Nolte Überstunden – Einstellungen">
        <sheet>
          <group col="6">
            <group string="Arbeitszeit (normal)">
              <field name="product_work_id" options="{'no_create': False, 'no_open': False}"/>
              <div class="text-muted">Standard-Artikel für normale Arbeitszeit.</div>
            </group>
            <group string="Fahrzeit (normal)">
              <field name="product_travel_id" options="{'no_create': False, 'no_open': False}"/>
              <div class="text-muted">Standard-Artikel für normale Fahrzeit.</div>
            </group>

            <group string="Arbeitszeit Überstunden 30 %">
              <field name="product_work_ot30_id" options="{'no_create': False, 'no_open': False}"/>
              <div class="text-muted">Artikel für Arbeitszeit mit 30 % Zuschlag.</div>
            </group>
            <group string="Arbeitszeit Überstunden 50 %">
              <field name="product_work_ot50_id" options="{'no_create': False, 'no_open': False}"/>
              <div class="text-muted">Artikel für Arbeitszeit mit 50 % Zuschlag.</div>
            </group>

            <group string="Fahrzeit Überstunden 30 %">
              <field name="product_travel_ot30_id" options="{'no_create': False, 'no_open': False}"/>
              <div class="text-muted">Artikel für Fahrzeit mit 30 % Zuschlag.</div>
            </group>
            <group string="Fahrzeit Überstunden 50 %">
              <field name="product_travel_ot50_id" options="{'no_create': False, 'no_open': False}"/>
              <div class="text-muted">Artikel für Fahrzeit mit 50 % Zuschlag.</div>
            </group>

            <group string="Kilometerpauschale">
              <field name="product_km_id" options="{'no_create': False, 'no_open': False}"/>
              <div class="text-muted">Artikel für Kilometerabrechnung.</div>
            </group>
            <group string="Übernachtungspauschale">
              <field name="product_overnight_id" options="{'no_create': False, 'no_open': False}"/>
              <div class="text-muted">Artikel für Übernachtungskosten.</div>
            </group>
          </group>
        </sheet>
        <footer>
          <button name="action_save" type="object" class="btn-primary" string="Speichern"/>
          <button special="cancel" class="btn-secondary" string="Abbrechen"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_nolte_overtime_settings" model="ir.actions.act_window">
    <field name="name">Einstellungen</field>
    <field name="res_model">nolte.overtime.settings</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <!-- menu lives under "Nolte Überstunden" root defined in menu.xml -->
  <menuitem id="menu_nolte_overtime_settings" name="Einstellungen"
            parent="nolte_overtime_billing.menu_nolte_overtime_root" sequence="20"
            action="action_nolte_overtime_settings"/>

</odoo>
