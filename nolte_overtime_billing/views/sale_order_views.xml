<odoo>
  <record id="view_sale_order_form_nolte_overtime_import" model="ir.ui.view">
    <field name="name">sale.order.form.nolte.overtime.import</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="%(nolte_overtime_billing.action_nolte_overtime_import_wizard)d"
                type="action"
                string="Überstunden-CSV importieren"
                class="btn-secondary"
                context="{'active_model': 'sale.order', 'active_id': active_id}"/>
      </xpath>
    </field>
  </record>
</odoo>
