<odoo>
    <record id="view_employee_form_nolte_stundenbericht" model="ir.ui.view">
        <field name="name">hr.employee.form.nolte.stundenbericht</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="nolte_stundenbericht_settings" string="Stundenbericht" groups="hr.group_hr_user">
                    <group>
                        <field name="stundenbericht_source"/>
                        <field name="stundenbericht_app_active_from" invisible="stundenbericht_source == 'csv'"/>
                    </group>
                    <p class="text-muted">
                        Im Parallelbetrieb dürfen CSV- und App-Berichte für verschiedene Einsatztage verwendet werden.
                        Für denselben Mitarbeiter und Tag darf nur eine Quelle genutzt werden.
                    </p>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
