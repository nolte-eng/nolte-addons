<odoo>
    <record id="view_flat_rate_list" model="ir.ui.view">
        <field name="name">nolte.service.flat.rate.list</field>
        <field name="model">nolte.service.flat.rate</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="product_id"/><field name="company_id" groups="base.group_multi_company"/><field name="active" optional="hide"/></list></field>
    </record>
    <record id="action_flat_rates" model="ir.actions.act_window">
        <field name="name">Pauschalen</field><field name="res_model">nolte.service.flat.rate</field><field name="view_mode">list,form</field>
        <field name="help" type="html"><p>Eine auswählbare Pauschale mit einem verkaufbaren Artikel anlegen. Jede gewählte Pauschale wird einmal pro Einsatzbericht nach der Abrechnungsfreigabe übernommen. Preise und Steuern bestimmt Odoo im Angebot.</p></field>
    </record>
    <menuitem id="menu_flat_rates" name="Pauschalen" parent="menu_nolte_stundenbericht_configuration" action="action_flat_rates" sequence="35" groups="group_stundenbericht_manager"/>
    <record id="view_report_flat_rates" model="ir.ui.view">
        <field name="name">nolte.service.report.flat.rates</field><field name="model">nolte.service.report</field><field name="inherit_id" ref="view_nolte_service_report_form"/>
        <field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Pauschalen"><p>Auswahl über den Bereich „Pauschalen“ in der mobilen Berichtseingabe. Übernahme einmal je Einsatzbericht bei der Abrechnungsfreigabe.</p><field name="flat_rate_line_ids" readonly="1"><list create="0" delete="0"><field name="name"/><field name="product_id"/><field name="sale_line_id" groups="group_stundenbericht_approver"/></list></field></page></xpath></field>
    </record>
    <record id="rule_flat_rate_company" model="ir.rule"><field name="name">Pauschalen: erlaubte Unternehmen</field><field name="model_id" ref="model_nolte_service_flat_rate"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="rule_report_flat_rate_company" model="ir.rule"><field name="name">Auswahlpauschalen: erlaubte Unternehmen</field><field name="model_id" ref="model_nolte_service_report_flat_rate"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="rule_report_flat_rate_own" model="ir.rule"><field name="name">Eigene Auswahlpauschalen lesen</field><field name="model_id" ref="model_nolte_service_report_flat_rate"/><field name="groups" eval="[(4, ref('group_stundenbericht_user'))]"/><field name="domain_force">[('report_id.owner_user_id', '=', user.id)]</field></record>
    <record id="rule_report_flat_rate_approver" model="ir.rule"><field name="name">Auswahlpauschalen prüfen</field><field name="model_id" ref="model_nolte_service_report_flat_rate"/><field name="groups" eval="[(4, ref('group_stundenbericht_approver'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
</odoo>
