<odoo>
    <record id="view_nolte_service_report_tree" model="ir.ui.view">
        <field name="name">nolte.service.report.list</field>
        <field name="model">nolte.service.report</field>
        <field name="arch" type="xml">
            <list js_class="nolte_service_report_list">
                <field name="name"/>
                <field name="display_service_date"/>
                <field name="partner_id"/>
                <field name="task_id"/>
                <field name="country_rate_key"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_nolte_service_report_form" model="ir.ui.view">
        <field name="name">nolte.service.report.form</field>
        <field name="model">nolte.service.report</field>
        <field name="arch" type="xml">
            <form string="Einsatzbericht" js_class="nolte_service_report_form">
                <header>
                    <button name="action_archive_completed" type="object" string="Archivieren" invisible="is_closed or state in ('draft', 'returned', 'awaiting_signature')" confirm="Diesen Bericht ins Archiv verschieben? Er bleibt dort und in der Kundenhistorie erhalten."/>
                    <button name="action_unarchive_manual" type="object" string="Aus Archiv holen" invisible="not archived_manually"/>
                    <button name="action_open_mobile_report" type="object" string="Stundenbericht öffnen" invisible="not task_id or not member_ids or state not in ('draft', 'returned') or owner_user_id != uid" groups="nolte_stundenbericht.group_stundenbericht_user"/>
                    <button name="action_open_service_task" type="object" string="Zum Einsatzauftrag" invisible="not task_id"/>
                    <button name="action_request_online_signature" type="object" string="Kundenunterschrift anfordern" invisible="state not in ('draft', 'returned')"/>
                    <button name="action_revoke_online_signature" type="object" string="Unterschriftsanfrage widerrufen" invisible="state != 'awaiting_signature'" confirm="Den Kundenlink ungültig machen und den Bericht wieder zur Bearbeitung freigeben?"/>
                    <button name="action_submit_review" type="object" string="Zur Prüfung" invisible="state not in ('customer_confirmed', 'internally_amended', 'returned')"/>
                    <button name="action_open_billing_approval_wizard" type="object" string="Abrechnung prüfen und an Verkauf übergeben" class="btn-primary" invisible="state != 'under_review'" groups="nolte_stundenbericht.group_stundenbericht_manager"/>
                    <button name="action_send_customer_pdf" type="object" string="PDF an Kunden senden" invisible="not partner_id and not manual_contact_email" groups="nolte_stundenbericht.group_stundenbericht_approver"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,awaiting_signature,customer_confirmed,internally_amended,under_review,ready_to_bill,billed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Im Archiv" bg_color="text-bg-success" invisible="not is_closed"/>
                    <field name="is_closed" invisible="1"/>
                    <field name="archived_manually" invisible="1"/>
                    <field name="planning_draft" invisible="1"/>
                    <field name="owner_user_id" invisible="1"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="service_date" invisible="planning_draft"/>
                            <field name="display_service_date" string="Geplanter Termin" invisible="not planning_draft"/>
                            <field name="partner_id"/>
                            <field name="manual_customer_name" invisible="partner_id"/>
                            <field name="manual_customer_street" invisible="partner_id"/>
                            <field name="manual_customer_zip" invisible="partner_id"/>
                            <field name="manual_customer_city" invisible="partner_id"/>
                            <field name="manual_contact_name" invisible="partner_id"/>
                            <field name="manual_contact_phone" invisible="partner_id"/>
                            <field name="manual_contact_email" invisible="partner_id"/>
                            <field name="sale_order_id"/>
                            <field name="task_id"/>
                            <field name="machine_number"/>
                            <field name="machine_type"/>
                        </group>
                        <group>
                            <field name="bmf_rate_year" invisible="1"/>
                            <field name="bmf_rate_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="country_rate_key" string="Bisheriger BMF-Schlüssel" readonly="1" invisible="bmf_rate_id"/>
                            <field name="service_location_name"/>
                            <field name="service_location_contact_name"/>
                            <field name="service_location_contact_phone"/>
                            <field name="service_location"/>
                            <field name="mobile_uuid" readonly="1"/>
                            <field name="server_revision" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mitarbeiter">
                            <group string="Übernachtungen im gesamten Einsatz">
                                <field name="employee_assignment_ids">
                                    <list editable="bottom"><field name="employee_id"/><field name="overnight_count"/></list>
                                </field>
                            </group>
                            <field name="member_ids">
                                <list editable="bottom">
                                    <field name="service_date"/>
                                    <field name="employee_id"/>
                                    <field name="billing_state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Bemerkungen">
                            <group><field name="work_description"/><field name="work_result"/><field name="public_note"/><field name="internal_note"/></group>
                        </page>
                        <page string="Material">
                            <field name="material_ids">
                                <list editable="bottom"><field name="product_id"/><field name="name"/><field name="quantity"/><field name="unit"/><field name="note"/></list>
                            </field>
                        </page>
                        <page string="Einsatzabschluss">
                            <p class="text-muted">Diese Prüfpunkte erscheinen im Kunden-Stundenbericht.</p>
                            <field name="customer_checklist_ids" context="{'default_visibility': 'customer'}">
                                <list editable="bottom"><field name="checked"/><field name="name"/><field name="note"/></list>
                            </field>
                        </page>
                        <page string="Fotos">
                            <field name="photo_ids" widget="many2many_binary" readonly="state not in ('draft', 'returned')"/>
                        </page>
                        <page string="Unterschrift / PDF-Rücklauf" groups="nolte_stundenbericht.group_stundenbericht_approver">
                            <p>Eine per E-Mail zurückgesandte, unterschriebene PDF kann hier nach Prüfung der richtigen Berichtsfassung hinterlegt werden. Die offene Online-Anfrage wird dadurch abgeschlossen.</p>
                            <group>
                                <field name="returned_pdf_signer" readonly="state != 'awaiting_signature'"/>
                                <field name="returned_pdf_filename" invisible="1"/>
                                <field name="returned_signed_pdf" filename="returned_pdf_filename" readonly="state != 'awaiting_signature'"/>
                            </group>
                            <button name="action_accept_returned_pdf" type="object" string="Geprüften PDF-Rücklauf übernehmen" invisible="state != 'awaiting_signature'" confirm="Haben Sie die Unterschrift und die Übereinstimmung mit der angefragten Berichtsfassung geprüft?"/>
                        </page>
                        <page string="Abrechnung">
                            <group string="Automatische Übergabe nach Kundenunterschrift">
                                <field name="spesen_sync_state" readonly="1"/>
                                <field name="spesen_sync_message" readonly="1"/>
                                <field name="attendance_sync_state" readonly="1"/>
                                <field name="attendance_sync_message" readonly="1"/>
                            </group>
                            <group>
                                <button name="action_sync_spesenbericht" type="object" string="Stunden und Spesen erneut übertragen" invisible="state not in ('customer_confirmed', 'internally_amended', 'under_review')" groups="nolte_stundenbericht.group_stundenbericht_approver"/>
                                <button name="action_sync_attendance" type="object" string="Anwesenheiten erneut übertragen" invisible="state not in ('customer_confirmed', 'internally_amended', 'under_review', 'ready_to_bill')" groups="nolte_stundenbericht.group_stundenbericht_approver"/>
                            </group>
                            <field name="member_ids" readonly="1">
                                <list>
                                    <field name="service_date"/>
                                    <field name="employee_id"/>
                                    <field name="billing_state"/>
                                    <field name="billing_approved"/>
                                    <field name="billing_sale_line_ids" widget="many2many_tags"/>
                                    <field name="attendance_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                        <page string="Konflikte">
                            <field name="conflict_ids" readonly="1">
                                <list><field name="employee_id"/><field name="conflict_date"/><field name="conflict_type"/><field name="state"/></list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_nolte_service_report_archive_search" model="ir.ui.view">
        <field name="name">nolte.service.report.archive.search</field>
        <field name="model">nolte.service.report</field>
        <field name="arch" type="xml">
            <search string="Stundenbericht-Archiv">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="service_date"/>
                <field name="machine_number"/>
                <filter name="group_customer" string="Kunde" context="{'group_by': 'partner_id'}"/>
                <filter name="group_month" string="Monat" context="{'group_by': 'service_date:month'}"/>
                <filter name="group_machine" string="Maschinennummer" context="{'group_by': 'machine_number'}"/>
            </search>
        </field>
    </record>

    <record id="action_nolte_service_report" model="ir.actions.act_window">
        <field name="name">Einsatzberichte</field>
        <field name="res_model">nolte.service.report</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_closed', '=', False)]</field>
    </record>

    <record id="action_nolte_service_report_archive" model="ir.actions.act_window">
        <field name="name">Stundenbericht-Archiv</field>
        <field name="res_model">nolte.service.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nolte_service_report_archive_search"/>
        <field name="domain">[('is_closed', '=', True)]</field>
        <field name="context">{'search_default_group_customer': 1, 'search_default_group_month': 1}</field>
    </record>

    <record id="action_nolte_stundenbericht_mobile" model="ir.actions.act_url">
        <field name="name">Stundenbericht eingeben</field>
        <field name="url">/nolte_stundenbericht/backend-entry</field>
        <field name="target">self</field>
    </record>

    <record id="action_nolte_service_report_compose" model="ir.actions.server">
        <field name="name">Stundenbericht per E-Mail senden</field>
        <field name="model_id" ref="model_nolte_service_report"/>
        <field name="state">code</field>
        <field name="code">action = env['nolte.service.report'].browse(env.context.get('active_id')).action_send_customer_pdf()</field>
    </record>

    <record id="action_nolte_service_request_signature" model="ir.actions.server">
        <field name="name">Kundenunterschrift anfordern</field>
        <field name="model_id" ref="model_nolte_service_report"/>
        <field name="state">code</field>
        <field name="code">action = env['nolte.service.report'].browse(env.context.get('active_id')).action_request_online_signature()</field>
    </record>

    <record id="action_nolte_stundenbericht_create_mobile" model="ir.actions.act_url">
        <field name="name">Stundenbericht erstellen</field>
        <field name="url">/my/stundenbericht</field>
        <field name="target">self</field>
    </record>

    <menuitem id="menu_nolte_stundenbericht_root" name="Stundenbericht"
              action="action_nolte_stundenbericht_mobile"
              web_icon="nolte_stundenbericht,static/description/icon.png"
              groups="nolte_stundenbericht.group_stundenbericht_user" sequence="40"/>
    <menuitem id="menu_nolte_service_report" name="Einsatzberichte"
              parent="menu_nolte_stundenbericht_root" action="action_nolte_service_report"
              groups="nolte_stundenbericht.group_stundenbericht_approver" sequence="10"/>
    <record id="action_nolte_open_service_project" model="ir.actions.server">
        <field name="name">Planung Aussendienst öffnen</field>
        <field name="model_id" ref="model_nolte_service_report"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_service_project()</field>
    </record>
    <menuitem id="menu_nolte_service_project" name="Planung"
              parent="menu_nolte_stundenbericht_root" action="action_nolte_open_service_project"
              groups="nolte_stundenbericht.group_stundenbericht_approver" sequence="12"/>
    <menuitem id="menu_project_nolte_service_reports" name="Stundenberichte"
              parent="project.menu_main_pm" action="action_nolte_stundenbericht_mobile"
              groups="nolte_stundenbericht.group_stundenbericht_approver" sequence="80"/>
    <menuitem id="menu_nolte_service_report_archive" name="Archiv"
              parent="menu_nolte_stundenbericht_root"
              groups="nolte_stundenbericht.group_stundenbericht_approver" sequence="20"/>
    <record id="menu_nolte_service_report_archive" model="ir.ui.menu">
        <field name="action" eval="False"/>
    </record>
    <menuitem id="menu_nolte_service_report_archive_current" name="Einsatzberichte"
              parent="menu_nolte_service_report_archive" action="action_nolte_service_report_archive"
              groups="nolte_stundenbericht.group_stundenbericht_approver" sequence="10"/>
    <menuitem id="menu_nolte_stundenbericht_create" name="Stundenbericht erstellen"
              parent="menu_nolte_stundenbericht_root"
              action="action_nolte_stundenbericht_create_mobile"
              groups="nolte_stundenbericht.group_stundenbericht_user" sequence="7"/>
    <menuitem id="menu_nolte_stundenbericht_configuration" name="Konfiguration"
              parent="menu_nolte_stundenbericht_root"
              groups="group_stundenbericht_manager" sequence="90"/>
</odoo>
