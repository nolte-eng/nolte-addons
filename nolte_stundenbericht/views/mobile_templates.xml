<?xml version="1.0"?>
<odoo>
  <template id="mobile_page_v2" name="Mobiler Stundenbericht – Mehrtägig">
    <t t-call="website.layout">
      <main id="wrap" class="ns-mobile-app">
        <section class="ns-app-shell" id="nolte-stundenbericht-mobile">
          <aside class="ns-sidebar" aria-label="Stundenbericht Navigation">
            <div class="ns-logo" aria-label="Nolte Engineering"><img t-att-src="'/web/image/res.company/%s/logo' % request.env.company.id" alt="Nolte Engineering"/></div>
            <nav>
              <a href="#" data-view-target="home"><i>▣</i>Berichte</a>
              <a href="#" data-view-target="general"><i>ⓘ</i>Allgemein</a>
              <a href="#" data-view-target="notes"><i>☰</i>Bemerkungen</a>
              <a href="#" data-view-target="times"><i>◷</i>Zeiterfassung</a>
              <a href="#" data-view-target="materials"><i>▤</i>Material</a>
              <a href="#" data-view-target="flat-rates"><i>€</i>Pauschalen</a>
              <a href="#" data-view-target="photos"><i>◉</i>Fotos</a>
              <a href="#" data-view-target="checklist"><i>✓</i>Einsatzabschluss</a>
              <a href="#" data-view-target="signature"><i>✎</i>Unterschrift</a>
            </nav>
            <div class="ns-user"><span>LN</span><small>Lars Nolte<br/>Monteur</small></div>
          </aside>
          <div class="ns-main" id="ns-top">
          <header class="ns-app-header mb-3">
            <div>
              <h1>Stundenbericht</h1>
              <p>Service. Maschinen. Mehr erreichen.</p>
            </div>
            <div class="text-end ns-header-actions"><span class="badge text-bg-secondary" data-status="">Offline bereit</span><small class="d-block mt-1" data-draft-state=""></small><button class="btn btn-primary mt-2" type="button" data-new-report="">＋ Neuer Bericht</button></div>
          </header>
          <div class="alert ns-message" data-message="">Entw&#xFC;rfe werden auf diesem Ger&#xE4;t gespeichert und bei Verbindung synchronisiert.</div>
          <section class="card mb-3" data-report-view="home" data-recent-reports=""><div class="card-body"><h2 class="h5 mb-2">Letzte Berichte</h2><p class="small text-muted mb-0">Wird geladen …</p></div></section>
          <section class="card mb-3" data-report-view="home" data-local-drafts=""><div class="card-body"><h2 class="h5 mb-2">Entwürfe auf diesem Gerät</h2><p class="small text-muted mb-0">Keine lokalen Entwürfe.</p></div></section>
          <nav class="ns-section-nav mb-3" aria-label="Berichtsbereiche">
            <a href="#" data-view-target="general">Allgemein</a><a href="#" data-view-target="notes">Bemerkungen</a><a href="#" data-view-target="times">Zeiterfassung</a><a href="#" data-view-target="materials">Material</a><a href="#" data-view-target="flat-rates">Pauschalen</a><a href="#" data-view-target="photos">Fotos</a><a href="#" data-view-target="checklist">Einsatzabschluss</a><a href="#" data-view-target="signature">Unterschrift</a>
          </nav>
          <form data-report-form="" style="display:block">
            <section class="card mb-3" data-report-view="flat-rates">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center gap-2"><h2 class="h5">Pauschalen</h2><button class="btn btn-outline-primary btn-sm" type="button" data-flat-rate-refresh="">Aktualisieren</button></div>
                <p class="text-muted">Zutreffende Pauschalen ankreuzen. Je ausgewählter Pauschale wird bei der Abrechnungsfreigabe ein Artikel mit Menge 1 auf das Angebot übernommen und von dort regulär abgerechnet.</p>
                <div data-flat-rate-list=""/>
                <p class="small text-muted mb-0 mt-2" data-flat-rate-status="" aria-live="polite">Pauschalen werden geladen …</p>
              </div>
            </section>
            <div class="card mb-3" id="ns-section-einsatz" data-report-view="general">
              <div class="card-body">
                <h2 class="h5">Einsatz</h2>
                <div class="row g-2">
                  <div class="col-6">
                    <label>Datum</label>
                    <input class="form-control" type="date" name="serviceDate" required="required"/>
                  </div>
                  <div class="col-12">
                    <label>Einsatzauftrag</label>
                    <select class="form-select" name="taskId">
                      <option value="">Ohne Zuordnung</option>
                    </select>
                  </div>
                  <div class="col-12 d-none" data-customer-history-wrap="">
                    <a class="btn btn-outline-primary" data-customer-history-link="" target="_blank" rel="noopener">Bisherige Stundenberichte dieses Kunden ansehen</a>
                  </div>
                  <div class="col-12 d-none" data-customer-card="">
                    <div class="border rounded bg-light p-3">
                      <div class="fw-bold" data-customer-display="">Kunde</div>
                      <div class="small text-muted" data-customer-address=""/>
                      <div class="small mt-2 d-none" data-contact-display=""><strong>Ansprechpartner:</strong> <span data-contact-name=""/> <span data-contact-phone=""/> <span data-contact-email=""/></div>
                    </div>
                  </div>
                  <div class="col-12 d-none" data-work-order-card="">
                    <div class="border rounded bg-light p-3">
                      <div class="fw-bold mb-1">Arbeitsauftrag / Hinweise für den Techniker</div>
                      <div class="small" data-work-order-description=""/>
                    </div>
                  </div>
                  <div class="col-12" data-manual-customer="">
                    <div class="border rounded bg-light p-3">
                      <div class="fw-bold mb-2">Firma und Ansprechpartner</div>
                      <p class="small text-muted mb-2">Für einen Bericht ohne Einsatzauftrag werden diese Daten nur für diesen Bericht erfasst.</p>
                      <div class="row g-2">
                        <div class="col-12 col-md-6"><label>Firma</label><input class="form-control" name="manualCustomerName" placeholder="Firmenname"/></div>
                        <div class="col-12 col-md-6"><label>Straße / Hausnummer</label><input class="form-control" name="manualCustomerStreet"/></div>
                        <div class="col-4"><label>PLZ</label><input class="form-control" name="manualCustomerZip"/></div>
                        <div class="col-8"><label>Ort</label><input class="form-control" name="manualCustomerCity"/></div>
                        <div class="col-12 col-md-6"><label>Ansprechpartner</label><input class="form-control" name="manualContactName"/></div>
                        <div class="col-6"><label>Telefon</label><input class="form-control" type="tel" name="manualContactPhone"/></div>
                        <div class="col-6"><label>E-Mail</label><input class="form-control" type="email" name="manualContactEmail"/></div>
                      </div>
                    </div>
                  </div>
                  <input type="hidden" data-customer-name=""/>
                  <div class="col-6">
                    <label>Land für BMF-Schlüssel</label>
                    <select class="form-select" name="countryRateKey" required="required"><option value="DE" selected="selected">Deutschland</option></select>
                  </div>
                  <div class="col-12" data-service-location-wrap="">
                    <label data-service-location-name-label="">Firma am Einsatzort</label>
                    <input class="form-control mb-2" name="serviceLocationName"/>
                    <div class="row g-2 mb-2">
                      <div class="col-12 col-md-6"><label>Ansprechpartner am Einsatzort</label><input class="form-control" name="serviceLocationContactName" placeholder="Name vor Ort"/></div>
                      <div class="col-12 col-md-6"><label>Telefon am Einsatzort</label><input class="form-control" type="tel" name="serviceLocationContactPhone" placeholder="Telefonnummer"/></div>
                    </div>
                    <label data-service-location-label="">Adresse Einsatzort</label>
                    <input class="form-control" name="serviceLocation"/>
                  </div>
                  <div class="col-6"><label>Maschinen-Nr.</label><input class="form-control" name="machineNumber"/></div>
                  <div class="col-6"><label>Maschinentyp</label><input class="form-control" name="machineType"/></div>
                  <div class="col-12">
                    <label>Bemerkung</label>
                    <textarea class="form-control" name="publicNote"/>
                  </div>
                </div>
              </div>
            </div>
            <div class="card mb-3" id="ns-section-zeiten" data-report-view="times">
              <div class="card-body">
                <h2 class="h5">Zeiten und Fahrt</h2>
                <p class="text-muted small mb-2 ns-ipad-help">Tage einzeln erfassen; Pausen beliebig ergänzen.</p>
                <div class="row g-2 align-items-end mb-2" data-time-employee-wrap="">
                  <div class="col-12 col-md-6"><label class="form-label mb-1">Mitarbeiter für diese Zeiten</label><select class="form-select" data-time-employee="" aria-label="Mitarbeiter für die Zeiterfassung"></select></div>
                  <div class="col-12 col-md-6 small text-muted" data-time-employee-help="">Zeiten werden für jeden Mitarbeiter getrennt gespeichert.</div>
                </div>
                <div class="mb-2" data-employee-overnights-wrap=""><label class="form-label mb-1" data-employee-overnights-label="">Übernachtungen für diesen Mitarbeiter im gesamten Einsatz</label><input class="form-control" type="number" min="0" step="1" value="0" data-employee-overnights=""/></div>
                <div class="d-flex justify-content-between align-items-end gap-2 mb-2 ns-day-toolbar">
                  <div><label class="form-label mb-1">Neuer Einsatztag</label><input class="form-control" type="date" data-day-date=""/></div>
                  <button class="btn btn-primary" type="button" data-day-add="">＋ Einsatztag hinzufügen</button>
                </div>
                <div data-day-list=""/>
              </div>
            </div>
            <section class="card mb-3" id="ns-section-arbeiten" data-report-view="notes">
              <div class="card-body">
                <h2 class="h5">Ausgeführte Arbeiten</h2>
                <div class="border rounded bg-light p-2 mb-3">
                  <label for="ns-work-template">Textvorlage <span class="text-muted">(optional)</span></label>
                  <div class="d-flex flex-wrap gap-2">
                    <select id="ns-work-template" class="form-select flex-grow-1 w-auto" data-work-template-select=""><option value="">Frei schreiben – ohne Vorlage</option></select>
                    <button type="button" class="btn btn-outline-primary" data-work-template-insert="" disabled="disabled">Vorlage einfügen</button>
                    <button type="button" class="btn btn-outline-secondary" data-work-template-refresh="">Vorlagen aktualisieren</button>
                  </div>
                  <p class="small text-muted mb-0 mt-2" data-work-template-status="" aria-live="polite">Vorlage auswählen oder direkt frei schreiben. Vorhandener Text bleibt beim Einfügen erhalten.</p>
                  <div class="small mt-2 d-none" data-work-template-preview="" style="white-space:pre-wrap"/>
                </div>
                <label for="ns-work-description">Arbeiten</label>
                <textarea id="ns-work-description" class="form-control mb-2" name="workDescription" rows="12" placeholder="Welche Arbeiten wurden durchgeführt?"/>
                <label>Fazit / weiterer Handlungsbedarf</label><textarea class="form-control" name="workResult" rows="3" placeholder="Ergebnis, Empfehlung oder weitere Arbeiten"/>
              </div>
            </section>
            <section class="card mb-3" data-report-view="times" data-time-table="">
              <div class="card-body">
                <h2 class="h5">Übersicht der Zeiterfassung</h2>
                <div class="table-responsive" role="region" aria-label="Zeiterfassung aller Mitarbeiter" tabindex="0">
                  <table class="table table-sm mb-0 ns-report-time-table">
                    <thead><tr><th scope="col">Datum</th><th scope="col">Mitarbeiter</th><th scope="col">Hinfahrt</th><th scope="col">Arbeitszeit</th><th scope="col">Pause</th><th scope="col">Rückfahrt</th><th scope="col" class="text-end">Hin-km</th><th scope="col" class="text-end">Rück-km</th><th scope="col" class="text-end">Gesamt-km</th><th scope="col" class="text-end">Übernachtungen</th></tr></thead>
                    <tbody data-time-table-body=""><tr><td colspan="10" class="text-muted">Noch keine Zeiten erfasst.</td></tr></tbody>
                    <tfoot data-time-table-totals=""/>
                  </table>
                </div>
              </div>
            </section>
            <section class="card mb-3" id="ns-section-material" data-report-view="materials" data-material-entry="">
              <div class="card-body">
                <h2 class="h5">Material <span class="text-muted small">optional</span></h2>
                <div class="row g-2">
                  <div class="col-12"><label>Odoo-Artikel suchen</label><div class="input-group"><input class="form-control" placeholder="Artikelname oder Nummer" data-product-search=""/><button class="btn btn-outline-secondary" type="button" data-product-search-button="">Suchen</button></div><div class="list-group mt-1 d-none" data-product-results=""/></div>
                  <div class="col-12"><label>Artikel / Material</label><input class="form-control" data-material-name=""/></div>
                  <div class="col-6"><label>Menge</label><input class="form-control" type="number" min="0" step="0.1" value="1" data-material-quantity=""/></div>
                  <div class="col-6"><label>Einheit</label><input class="form-control" value="Stk." data-material-unit=""/></div>
                  <div class="col-12"><label>Bemerkung</label><input class="form-control" data-material-note=""/></div>
                </div>
                <button class="btn btn-outline-primary w-100 mt-3" type="button" data-material-add="">Material hinzufügen</button>
                <div class="small mt-3" data-material-list=""/>
              </div>
            </section>
            <section class="card mb-3" id="ns-section-checkliste" data-report-view="checklist" data-checklist-entry="">
              <div class="card-body">
                <h2 class="h5">Einsatzabschluss <span class="text-muted small">optional</span></h2>
                <section class="border rounded p-3" data-checklist-kind="customer">
                  <p class="small text-muted">Diese Punkte samt Status und Bemerkung erscheinen im Kunden-PDF.</p>
                  <label for="ns-customer-checklist-name">Eigener Prüfpunkt</label>
                  <div class="input-group"><input id="ns-customer-checklist-name" class="form-control" data-checklist-name=""/><button class="btn btn-outline-primary" type="button" data-checklist-add="">Hinzufügen</button></div>
                  <div class="mt-3" data-checklist-list=""/>
                  <p class="small text-muted mb-0 mt-2" data-checklist-status="" aria-live="polite"/>
                </section>
              </div>
            </section>
            <section class="card mb-3" id="ns-section-fotos" data-report-view="photos" data-photo-entry="">
              <div class="card-body">
                <h2 class="h5">Fotos <span class="text-muted small">optional</span></h2>
                <div class="d-flex flex-wrap gap-2">
                  <label class="btn btn-primary mb-0">Foto aufnehmen<input class="d-none" type="file" accept="image/*" capture="environment" data-photo-input=""/></label>
                  <label class="btn btn-outline-primary mb-0">Datei auswählen<input class="d-none" type="file" accept="image/*" multiple="multiple" data-photo-input=""/></label>
                </div>
                <p class="small text-muted mb-0 mt-2" data-photo-status="">Fotos werden zusammen mit dem nächsten Synchronisieren hochgeladen.</p>
                <div class="row g-2 mt-1" data-photo-preview=""/>
              </div>
            </section>
          </form>
          <section class="card mt-3" data-report-view="signature">
            <div class="card-body">
              <p class="mb-0" data-transfer-status="" role="status" aria-live="polite">Beim Öffnen wird der Bericht automatisch übertragen.</p>
              <button class="btn btn-outline-primary mt-2 d-none" type="button" data-transfer-retry="">Erneut versuchen</button>
            </div>
          </section>
          <section class="card mt-3 d-none" id="ns-section-unterschrift" data-report-view="signature" data-confirmation="">
            <div class="card-body">
              <h2 class="h5">Kundenbestätigung</h2>
              <p class="small mb-2">Mit der Unterschrift wird die Kundenfassung festgeschrieben. Eine vorher eingetragene Rückfahrt bleibt darin enthalten; eine fehlende Rückfahrt kann danach intern ergänzt werden.</p>
              <div class="border rounded bg-light p-2 mb-3" data-confirmation-preview="">
                <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                  <strong class="me-auto">Kundenbericht zur Prüfung</strong>
                  <button type="button" class="btn btn-sm btn-outline-primary" data-confirmation-format="pdf" aria-pressed="false">PDF-Vorschau</button>
                  <button type="button" class="btn btn-sm btn-outline-primary" data-confirmation-format="html" aria-pressed="false">Ansicht wie PDF</button>
                  <a class="btn btn-sm btn-outline-primary d-none" data-confirmation-pdf-open="" target="_blank" rel="noopener">PDF separat öffnen</a>
                </div>
                <p class="small text-muted mb-2" data-confirmation-preview-status="" role="status">Die Vorschau erscheint nach der Synchronisation.</p>
                <iframe class="w-100 bg-white border rounded d-none" style="height:70vh; min-height:360px; max-height:900px;" title="Vorschau des Kunden-Stundenberichts vor der Unterschrift" data-confirmation-preview-frame=""/>
              </div>
              <div data-local-customer-signature="">
              <label>Name des Unterzeichners</label>
              <input class="form-control mb-2" name="signerName" data-signer-name=""/>
              <label>Unterschrift</label>
              <canvas class="w-100 border rounded bg-white" data-signature="" height="180" aria-label="Unterschriftsfeld"></canvas>
              <div class="d-flex gap-2 mt-2">
                <button class="btn btn-outline-secondary" type="button" data-signature-clear="">L&#xF6;schen</button>
                <button class="btn btn-success flex-grow-1" type="button" data-confirm="">Kundenbest&#xE4;tigung abschlie&#xDF;en</button>
              </div>
              </div>
              <div class="border-top mt-3 pt-3">
                <h3 class="h6">Niemand mehr vor Ort?</h3>
                <p class="small">Fordere die Kundenunterschrift per E-Mail an. Empfänger und Nachricht kannst du im nächsten Dialog bearbeiten. Die synchronisierte Fassung wird dabei gesperrt. Wenn du den Versand abbrichst, kannst du die Anfrage im Backend widerrufen.</p>
                <a class="btn btn-outline-primary d-none" data-request-online-signature="" target="_blank" rel="noopener">Niemand vor Ort – Unterschrift anfordern</a>
                <p class="alert alert-info d-none" data-online-signature-pending=""/>
                <a class="btn btn-outline-secondary d-none" data-online-signature-manage="" target="_blank" rel="noopener">Unterschriftsanfrage verwalten</a>
              </div>
            </div>
          </section>
          <section class="card mt-3 d-none" data-report-view="signature" data-pdf-preview="">
            <div class="card-body text-center"><h2 class="h5" data-pdf-title="">PDF-Vorschau</h2><p class="small text-muted" data-pdf-description="">So sieht der Bericht für den Kunden aus. Die finale Fassung enthält zusätzlich die Kundenunterschrift.</p><a class="btn btn-outline-primary w-100" target="_blank" data-pdf-link="">PDF-Vorschau öffnen</a>
              <div class="d-none border-top mt-3 pt-3 text-start" data-customer-email-panel="">
                <h3 class="h6">Bericht per E-Mail senden</h3>
                <p class="small text-muted mb-2">Empfänger, Betreff und Nachricht kannst du im Odoo-E-Mail-Dialog vor dem Senden bearbeiten. Der unterschriebene Bericht ist als PDF angehängt.</p>
                <div class="small text-muted mb-2">Firmenkopie vorbelegt: <span data-company-service-email=""/></div>
                <a class="btn btn-primary w-100" data-customer-email-compose="" target="_blank" rel="noopener">E-Mail vorbereiten</a>
              </div>
            </div>
          </section>
          <section class="card mt-3 d-none" data-report-view="times" data-return-trip="">
            <div class="card-body">
              <h2 class="h5">Interne Rückfahrt</h2>
              <p class="small">Diese Angaben werden nach der Kundenbestätigung nur intern gespeichert.</p>
              <div class="row g-2">
                <div class="col-6"><label>von</label><input class="form-control" type="time" data-return-start=""/></div>
                <div class="col-6"><label>bis</label><input class="form-control" type="time" data-return-end=""/></div>
                <div class="col-12"><label>Kilometer</label><input class="form-control" type="number" min="0" step="0.1" data-return-km=""/></div>
              </div>
              <button class="btn btn-primary w-100 mt-3" type="button" data-return-save="">Rückfahrt intern speichern</button>
            </div>
          </section>
          </div>
        </section>
      </main>
        <script type="module" src="/nolte_stundenbericht/static/src/js/uuid.js?v=2"/>
        <script type="module" src="/nolte_stundenbericht/static/src/js/day_copy.js?v=1"/>
        <script type="module" src="/nolte_stundenbericht/static/src/js/mobile.js?v=66"/>
        <script type="module" src="/nolte_stundenbericht/static/src/js/flat_rates.js?v=2"/>
        <script type="module" src="/nolte_stundenbericht/static/src/js/return_trip.js?v=5"/>
        <script type="module" src="/nolte_stundenbericht/static/src/js/materials.js?v=6"/>
        <script type="module" src="/nolte_stundenbericht/static/src/js/checklist.js?v=7"/>
        <script type="module" src="/nolte_stundenbericht/static/src/js/photos.js?v=6"/>
        <script type="module" src="/nolte_stundenbericht/static/src/js/recent_reports.js?v=4"/>
        <script type="module" src="/nolte_stundenbericht/static/src/js/confirmation_preview.js?v=4"/>
        <script src="/nolte_stundenbericht/static/src/js/request_online_signature.js?v=2" defer="defer"/>
        <script type="module" src="/nolte_stundenbericht/static/src/js/pdf_preview.js?v=2"/>
        <script type="module" src="/nolte_stundenbericht/static/src/js/local_drafts.js?v=2"/>
        <script type="module" src="/nolte_stundenbericht/static/src/js/view_navigation.js?v=2"/>
    </t>
  </template>
  <!-- The website quick-login widget can be unavailable in a freshly cloned database.
         Keep the regular Odoo login form accessible in all environments. -->
  <template id="login_form_always_visible" inherit_id="web.login">
    <xpath expr="//form[@t-attf-class]" position="attributes">
      <attribute name="t-attf-class">oe_login_form</attribute>
    </xpath>
  </template>
</odoo>
