<odoo>

    <data>


        <!-- New report layout for din5008 format -->
        <template id="external_layout_german" inherit_id="l10n_din5008.external_layout_din5008">


            <!-- LOGO und Report-Header ersetzen -->
            <xpath expr="//table[hasclass('company_header', 'table-borderless')]" position="replace">

                <t t-set="company" t-value="res_company"/>

                <link rel="stylesheet" href="/nolte_berichte/static/src/scss/report_patch.scss"/>
                <table class="company_header table-borderless"
                       t-att-style="'height: %dmm;' % (din_header_spacing or 27)">
                    <tr>
                        <td>
                            <h3 class="mt0" t-field="company.report_header"/>
                        </td>
                        <td>
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                                 t-att-style="'max-height: %dmm;' % (din_header_spacing or 27)"/>
                        </td>
                    </tr>
                </table>
            </xpath>


            <xpath expr="//div[@id='din5008_report_main_address']" position="replace">
                <div class="address" id="din5008_report_main_address">
                    <div class="colored_address" style="font-size: 8px;">
                        <t t-if="company.name">
                            <span t-field="company.name"/>
                        </t>
                        <t t-if="company.street">
                            <span>|</span>
                            <span t-field="company.street"/>
                        </t>
                        <t t-if="company.street2">
                            <span>|</span>
                            <span t-field="company.street2"/>
                        </t>
                        <t t-if="company.zip">
                            <span>|</span>
                            <span t-field="company.zip"/>
                        </t>
                        <t t-if="company.city">
                            <span t-if="not company.zip">|</span>
                            <span t-field="company.city"/>
                        </t>
                    </div>
                    <div t-if="address">
                        <t t-out="address"/>
                    </div>
                    <div t-else="fallback_address">
                        <t t-esc="fallback_address"
                           t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                    </div>
                </div>
            </xpath>

            <xpath expr="//div[hasclass('company_details')]" position="replace">

                <div class="company_details" t-att-style="'color: %s;' % primary if primary else ''">

                    <table class="table-borderless">
                        <tr>
                            <td>
                                <ul class="list-inline">
                                    <li t-if="company.name">
                                        <span t-field="company.name"/>
                                    </li>
                                    <li t-if="company.street">
                                        <span t-field="company.street"/>
                                    </li>
                                    <li t-if="company.street2">
                                        <span t-field="company.street2"/>
                                    </li>
                                    <li>
                                        <span t-if="company.zip" t-field="company.zip"/>
                                        <span t-if="company.city" t-field="company.city"/>
                                    </li>
                                    <!-- <li t-if="company.country_id"><span t-field="company.country_id.name"/></li> -->
                                </ul>
                            </td>
                            <td>
                                <ul class="list-inline">
                                    <li t-if="company.phone">
                                        <i class="fa fa-fw fa-phone-square"/>
                                        <span t-field="company.phone"/>
                                    </li>
                                    <li t-if="company.email">
                                        <i class="fa fa-fw fa-envelope"/>
                                        <span t-field="company.email"/>
                                    </li>
                                    <li t-if="company.website">
                                        <i class="fa fa-fw fa-globe"/>
                                        <span t-field="company.website"/>
                                    </li>
                                </ul>
                            </td>
                            <td>
                                <ul class="list-inline">
                                    <li t-if="company.vat">
                                        <t t-esc="company.account_fiscal_country_id.vat_label or 'Tax ID'"/>:
                                        <span t-field="company.vat"/>
                                    </li>
                                    <li>HRB Nr:
                                        <span t-field="company.company_registry"/>
                                    </li>
                                    <div t-field="company.report_footer"/>
                                </ul>
                            </td>
                            <td>
                                <ul class="list-inline">
                                    <li>executive director</li>
                                    <li t-if="company.ceo_01">
                                        <span t-field="company.ceo_01"/>
                                    </li>
                                    <li t-if="company.ceo_02">
                                        <span t-field="company.ceo_02"/>
                                    </li>
                                    <li t-if="not company.ceo_02">
                                        <br/>
                                    </li>
                                </ul>
                            </td>
                            <td>
                                <ul class="list-inline" t-if="company.partner_id.bank_ids">
                                    <t t-foreach="company.partner_id.bank_ids[:2]" t-as="bank">
                                        <li>
                                            <i class="fa fa-fw fa-bank"/>
                                            <span t-field="bank.bank_id.name"/>
                                        </li>
                                        <li>
                                            <i class="fa fa-fw fa-money"/>
                                            <span t-field="bank.acc_number"/>
                                        </li>
                                        <li>
                                            <i class="fa fa-fw fa-building"/>
                                            <span t-field="bank.bank_id.bic"/>
                                        </li>
                                    </t>
                                </ul>
                            </td>
                        </tr>
                    </table>
                </div>
            </xpath>



        </template>

    </data>
</odoo>
